# 本地开发示例；复制到 .env，.env 已被 Git 忽略。
POSTGRES_DB=modular_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_dev
POSTGRES_PORT=5432

# Python 使用此连接地址；修改账号、密码或端口时须同步修改这里。
DATABASE_URL=postgresql://rag:rag_local_dev@127.0.0.1:5432/modular_rag

# 上传文件保存（可选）：默认 data/uploads；单份 20 MiB、单次 10 份、总量 100 MiB。
UPLOAD_ROOT=data/uploads
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_BYTES=104857600
